[Unit]
Description=Telegram 24/7 Live Stream Bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-live-bot
EnvironmentFile=/opt/telegram-live-bot/.env
ExecStart=/usr/bin/python3 /opt/telegram-live-bot/bot.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/telegram-live-bot/videos /opt/telegram-live-bot/logs /opt/telegram-live-bot/sessions

[Install]
WantedBy=multi-user.target