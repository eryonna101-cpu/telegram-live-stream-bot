# Required Telegram Bot API credentials
BOT_TOKEN=
OWNER_ID=

# Telegram client credentials from https://my.telegram.org
API_ID=
API_HASH=

# MongoDB connection used by the bot
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=telegram_live_bot

# Public channel username (@channel) or numeric channel ID
CHANNEL_ID=

# Optional defaults. RTMP values can also be entered from the settings screen.
RTMP_URL=
STREAM_KEY=
PYROGRAM_SESSION_NAME=sessions/telegram_client

# Runtime paths and limits
VIDEO_DIR=videos
LOG_DIR=logs
MAX_VIDEO_SIZE_GB=0
LOW_STORAGE_GB=10
FFMPEG_RESTART_LIMIT=5
FFMPEG_RESTART_DELAY=5

# Broadcast defaults
VIDEO_BITRATE=2500k
AUDIO_BITRATE=128k
RESOLUTION=1280x720
FPS=30
FFMPEG_PRESET=veryfast